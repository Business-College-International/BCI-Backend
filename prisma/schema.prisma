  termId        String
  invoiceNumber String        @unique
  status        InvoiceStatus @default(OPEN)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  notes         String?

  student     Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term        Term               @relation(fields: [termId], references: [id], onDelete: Restrict)
  lines       InvoiceLine[]
  allocations      PaymentAllocation[]
  paymentIntents   PaymentIntent[]

  @@index([studentId, termId, status])
}

model InvoiceLine {
  id            String  @id @default(uuid())
  invoiceId     String
  feeScheduleId String?
  description   String
  amountDue     Decimal @db.Decimal(12, 2)

  invoice     StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeSchedule FeeSchedule?   @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model Payment {
  id                String        @id @default(uuid())
  studentId         String?
  guardianId        String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("GHS")
  purpose           PaymentPurpose
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerReference String?
  clientReference   String?
  idempotencyKey    String?
  createdAt         DateTime      @default(now())
  completedAt       DateTime?
  failureCode       String?
  failureMessage    String?

  allocations        PaymentAllocation[]
  receipt            Receipt?
  refunds            Refund[]
  attempts           PaymentProviderAttempt[]
  walletTransactions WalletTransaction[]
  paymentIntents     PaymentIntent[]

  @@index([studentId, createdAt])
  @@index([guardianId, createdAt])
  @@index([status, createdAt])
  @@index([provider, providerReference])
}

model PaymentIntent {
  id                String              @id @default(uuid())
  studentId         String
  invoiceId         String
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("GHS")
  status            PaymentIntentStatus @default(PENDING)
  initiatedByUserId String
  provider          String?
  providerReference String?
  clientReference   String?
  idempotencyKey    String
  paymentId         String?
  expiresAt         DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  completedAt       DateTime?
  failureCode       String?
  failureMessage    String?

  student Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoice StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([invoiceId, status, expiresAt])
  @@index([studentId, createdAt])
  @@index([provider, providerReference])
  @@index([paymentId])
  @@index([initiatedByUserId, idempotencyKey])
}

model PaymentProviderAttempt {
  id                String        @id @default(uuid())
  paymentId         String
  provider          String
  providerReference String?
  status            PaymentStatus @default(PENDING)
  requestPayload    Json?
  responsePayload   Json?
  requestedAt       DateTime      @default(now())
  resolvedAt        DateTime?
  failureCode       String?
  failureMessage    String?