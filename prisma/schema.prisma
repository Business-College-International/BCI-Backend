// BCI School Management System — authoritative domain schema foundation.
// Financial records are append-oriented. Student academic history is represented
// by enrolments rather than mutable class/level fields on Student.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName { DIRECTOR PRINCIPAL OFFICE ACCOUNTANT TEACHER SUPPORT_STAFF GUARDIAN APPLICANT }
enum Level { KG1 KG2 P1 P2 P3 P4 P5 P6 JHS1 JHS2 JHS3 SHS1 SHS2 SHS3 }
enum Programme { NONE AGRIC GENERAL_ARTS BUSINESS HOME_ECONOMICS }
enum UserStatus { ACTIVE SUSPENDED DISABLED }
enum StudentStatus { ACTIVE GRADUATED WITHDRAWN TRANSFERRED }
enum ApplicationStatus { PENDING UNDER_REVIEW ADMITTED REJECTED WITHDRAWN }
enum EnrollmentStatus { ACTIVE COMPLETED WITHDRAWN TRANSFERRED }
enum TermStatus { DRAFT OPEN CLOSED }
enum AttendanceStatus { PRESENT ABSENT LATE EXCUSED }
enum AssessmentType { CLASSWORK TEST EXAM PROJECT OTHER }
enum InvoiceStatus { OPEN PARTIALLY_PAID PAID VOID }
enum PaymentStatus { PENDING PROCESSING SUCCEEDED FAILED CANCELLED REFUNDED }
enum PaymentPurpose { FEE WALLET_TOP_UP STATIONERY OTHER }
enum WalletTransactionType { TOP_UP WITHDRAWAL REVERSAL }
enum ExpenseStatus { DRAFT SUBMITTED APPROVED REJECTED PAID VOID }
enum PayrollPeriodStatus { DRAFT CALCULATED APPROVED PROCESSING PAID CLOSED }
enum DisbursementStatus { PENDING PROCESSING SUCCEEDED FAILED REVERSED }
enum AdmissionDecision { ADMITTED REJECTED }
enum AuditAction { CREATE UPDATE DELETE APPROVE REJECT LOGIN LOGOUT DISBURSE RECONCILE }

model Person {
  id                 String   @id @default(uuid())
  firstName          String
  middleName         String?
  lastName           String
  dateOfBirth        DateTime?
  phone              String?
  email              String?
  address            String?
  hometown           String?
  region             String?
  occupation         String?
  photoUrl           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User?
  guardian           Guardian?
  staff              Staff?
  emergencyContacts  EmergencyContact[]
  auditLogsAsPerson  AuditLog[] @relation("AuditActor")
}

model User {
  id                    String     @id @default(uuid())
  personId              String?    @unique
  email                 String?    @unique
  phone                 String?    @unique
  passwordHash          String
  status                UserStatus @default(ACTIVE)
  tokenVersion          Int        @default(0)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  person                Person?    @relation(fields: [personId], references: [id])
  roles                 UserRole[]
  directPermissions     UserPermission[]
  guardian              Guardian?
  staff                 Staff?
  idempotencyKeys       IdempotencyKey[]
  auditLogsAsUser       AuditLog[] @relation("UserAuditActor")
  notificationDeliveries NotificationDelivery[]
  sessions              RefreshSession[]
}

model RefreshSession {
  id               String   @id @default(uuid())
  userId           String
  tokenHash        String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  replacedById     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model RolePermission {
  id             String   @id @default(uuid())
  role           RoleName
  permissionCode String
  grantedAt      DateTime @default(now())

  @@unique([role, permissionCode])
  @@index([permissionCode, role])
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  role       RoleName
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role])
}

model UserPermission {
  id             String   @id @default(uuid())
  userId         String
  permissionCode String
  scopeType      String?
  scopeId        String?
  grantedAt      DateTime @default(now())
  grantedBy      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, permissionCode])
  @@index([permissionCode, scopeType, scopeId])
}

model IdempotencyKey {
  id           String  @id @default(uuid())
  userId       String?
  key          String
  operation    String
  requestHash  String
  responseJson Json?
  statusCode   Int?
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  user User? @relation(fields: [userId], references: [id])
  @@unique([userId, key, operation])
}

model AcademicYear {
  id         String   @id @default(uuid())
  name       String   @unique
  startsAt   DateTime
  endsAt     DateTime
  isCurrent  Boolean  @default(false)
  createdAt  DateTime @default(now())

  terms      Term[]
  classes    SchoolClass[]
  enrolments Enrolment[]
}

model Term {
  id                  String     @id @default(uuid())
  academicYearId      String
  code                String
  name                String
  startsAt            DateTime
  endsAt              DateTime
  status              TermStatus @default(DRAFT)

  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  teacherAssignments  TeacherAssignment[]
  attendanceSessions  AttendanceSession[]
  feeSchedules        FeeSchedule[]
  assessments         Assessment[]
  enrolments          Enrolment[]
  studentInvoices     StudentInvoice[]

  @@unique([academicYearId, code])
  @@index([status, startsAt])
}

model Guardian {
  personId             String  @id
  userId               String? @unique
  occupationOverride   String?
  preferredSms         Boolean @default(true)
  preferredPush        Boolean @default(true)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
  wards  GuardianStudent[]
}

model GuardianStudent {
  id               String  @id @default(uuid())
  guardianId       String
  studentId        String
  relationship     String
  isPrimaryContact Boolean @default(false)
  canViewAcademic  Boolean @default(true)
  canPayFees       Boolean @default(true)
  canManageWallet  Boolean @default(true)

  guardian Guardian @relation(fields: [guardianId], references: [personId], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([guardianId, studentId])
  @@index([studentId, isPrimaryContact])
}

model EmergencyContact {
  id           String  @id @default(uuid())
  personId     String
  name         String
  relationship String
  phone        String
  isPrimary    Boolean @default(false)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@index([personId])
}

model Staff {
  personId         String   @id
  userId           String?  @unique
  staffIdNo        String   @unique
  department       String?
  employmentDate   DateTime?
  contractType     String?
  employmentStatus String   @default("active")

  person               Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  user                 User?  @relation(fields: [userId], references: [id])
  duties               StaffDuty[]
  teaching             TeacherAssignment[]
  salary               SalaryStructure?
  payrollEntries       PayrollEntry[]
  disbursementAttempts DisbursementAttempt[]
}

model StaffDuty {
  id               String   @id @default(uuid())
  staffId          String
  description      String
  startsAt         DateTime?
  endsAt           DateTime?
  assignedByUserId String?
  active            Boolean  @default(true)

  staff Staff @relation(fields: [staffId], references: [personId], onDelete: Cascade)
  @@index([staffId, active])
}

model SchoolClass {
  id             String    @id @default(uuid())
  academicYearId String
  name           String
  level          Level
  programme      Programme @default(NONE)
  division       String?
  room           String?
  capacity       Int?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  enrolments   Enrolment[]
  assignments  TeacherAssignment[]
  sessions     AttendanceSession[]

  @@unique([academicYearId, name])
  @@index([academicYearId, level, programme])
}

model Subject {
  id                  String    @id @default(uuid())
  code                String    @unique
  name                String
  level               Level
  isElective          Boolean   @default(false)
  programme           Programme @default(NONE)
  isActive            Boolean   @default(true)

  assignments         TeacherAssignment[]
  electives           StudentElective[]
  assessments         Assessment[]
  attendanceSessions  AttendanceSession[]
}

model Enrolment {
  id             String           @id @default(uuid())
  studentId      String
  academicYearId String
  termId         String
  classId        String
  level          Level
  programme      Programme
  status         EnrollmentStatus @default(ACTIVE)
  sequence       Int              @default(1)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  exitReason     String?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Restrict)
  class        SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  electives    StudentElective[]

  @@unique([studentId, termId, sequence])
  @@index([classId, termId, status])
  @@index([studentId, academicYearId])
  @@index([studentId, termId, status])
}

model TeacherAssignment {
  id        String @id @default(uuid())
  staffId   String
  classId   String
  subjectId String
  termId    String

  staff   Staff       @relation(fields: [staffId], references: [personId], onDelete: Restrict)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  term    Term        @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@unique([staffId, classId, subjectId, termId])
  @@index([staffId, termId])
  @@index([classId, termId])
}

model SalaryStructure {
  staffId     String   @id
  basePay     Decimal  @db.Decimal(12, 2)
  allowances  Json?
  deductions  Json?
  effectiveAt DateTime @default(now())
  endedAt     DateTime?

  staff Staff @relation(fields: [staffId], references: [personId], onDelete: Cascade)
}

model PayrollPeriod {
  id            String              @id @default(uuid())
  code          String              @unique
  startsAt      DateTime
  endsAt        DateTime
  status        PayrollPeriodStatus @default(DRAFT)
  approvedBy    String?
  approvedAt    DateTime?
  paidAt        DateTime?

  entries       PayrollEntry[]
  disbursements DisbursementAttempt[]
}

model PayrollEntry {
  id                  String  @id @default(uuid())
  periodId            String
  staffId             String
  grossPay            Decimal @db.Decimal(12, 2)
  totalDeductions     Decimal @db.Decimal(12, 2)
  netPay              Decimal @db.Decimal(12, 2)
  calculationJson     Json?
  status              String  @default("pending")
  createdAt           DateTime @default(now())

  period              PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  staff               Staff @relation(fields: [staffId], references: [personId], onDelete: Restrict)
  disbursementAttempts DisbursementAttempt[]

  @@unique([periodId, staffId])
  @@index([staffId, periodId])
}

model DisbursementAttempt {
  id                  String             @id @default(uuid())
  payrollPeriodId     String?
  payrollEntryId      String?
  staffId             String?
  purpose             String
  amount              Decimal            @db.Decimal(12, 2)
  status              DisbursementStatus @default(PENDING)
  provider            String?
  providerReference   String?
  idempotencyKey      String?
  requestedAt         DateTime           @default(now())
  completedAt         DateTime?
  failureCode         String?
  failureMessage      String?

  payrollPeriod       PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  payrollEntry        PayrollEntry?  @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
  staff               Staff?         @relation(fields: [staffId], references: [personId], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([provider, providerReference])
}

model Student {
  id                String        @id @default(uuid())
  applicationId     String?       @unique
  admissionNumber   String?       @unique
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  sex               String?
  hometown           String?
  region            String?
  passportPhotoUrl  String?
  previousSchool    String?
  status            StudentStatus @default(ACTIVE)
  admittedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  application       Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  guardians         GuardianStudent[]
  documents         StudentDocument[]
  electives         StudentElective[]
  enrolments        Enrolment[]
  attendance        AttendanceRecord[]
  assessmentResults AssessmentResult[]
  invoices          StudentInvoice[]
  wallet            Wallet?
}

model StudentDocument {
  id        String   @id @default(uuid())
  studentId String
  type      String
  fileUrl   String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([studentId, type])
}
